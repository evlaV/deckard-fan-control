[Unit]
Description=Deckard fan control

[Service]
Type=simple

ExecStart=/usr/share/deckard-fan-control/fancontrol.py --run
ExecStopPost=/usr/share/deckard-fan-control/fancontrol.py --stop
CPUAffinity=1,2,3

# disable buffering so STDOUT and STDERR show up immediately in logs
Environment=PYTHONUNBUFFERED=1

OOMScoreAdjust=-1000
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target